        <mxCell id="internal_secret_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;dashed=1;dashPattern=5 5;" value="&lt;div style=&#39;text-align:center;font-size:10px;color:#666;&#39;&gt;&lt;b&gt;All /internal/* calls require&lt;/b&gt;&lt;br&gt;X-Internal-Secret header&lt;br&gt;(shared INTERNAL_SECRET env var)&lt;/div&gt;" vertex="1">
