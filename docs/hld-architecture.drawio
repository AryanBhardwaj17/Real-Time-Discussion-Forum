        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;shadow=1;" value="&lt;div style=&#39;text-align:left;padding:8px;font-size:11px;line-height:1.9;&#39;&gt;&lt;b style=&#39;font-size:13px;&#39;&gt;LEGEND&lt;/b&gt;&lt;br&gt;---&lt;br&gt;&lt;b&gt;Solid line&lt;/b&gt; = Synchronous HTTP&lt;br&gt;&lt;b&gt;Dashed line&lt;/b&gt; = Async events (Streams/Pub-Sub)&lt;br&gt;&lt;b style=&#39;color:#C62828;&#39;&gt;Red&lt;/b&gt; = Redis event flow&lt;br&gt;&lt;b style=&#39;color:#666;&#39;&gt;Grey&lt;/b&gt; = Gateway proxy / inter-service HTTP&lt;br&gt;---&lt;br&gt;&lt;b&gt;Docker containers:&lt;/b&gt; 7 services + 4 PG + 1 Redis + 1 Meilisearch&lt;br&gt;&lt;b&gt;Auth pattern:&lt;/b&gt; HS256 JWT in HttpOnly cookies&lt;br&gt;&lt;b&gt;Durable events:&lt;/b&gt; Redis Streams + XREADGROUP consumer groups&lt;br&gt;&lt;b&gt;Ephemeral events:&lt;/b&gt; Redis Pub/Sub &amp;rarr; WebSocket broadcast&lt;br&gt;&lt;b&gt;Pagination:&lt;/b&gt; Cursor-based (CursorPage&amp;lt;T&amp;gt;)&lt;br&gt;&lt;b&gt;Stack:&lt;/b&gt; FastAPI + Uvicorn (all 7 services)&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="380" x="970" y="930" as="geometry" />
        </mxCell>
        <mxCell id="flow_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;shadow=1;" value="&lt;div style=&#39;text-align:center;font-size:10px;color:#333;line-height:1.6;&#39;&gt;&lt;b&gt;Event Flow Example: User Likes a Thread&lt;/b&gt;&lt;br&gt;1. Client &amp;rarr; Gateway &amp;rarr; Content Service (HTTP)&lt;br&gt;2. Content &amp;rarr; XADD stream:notifications (Redis Stream)&lt;br&gt;3. Content &amp;rarr; XADD stream:audit (Redis Stream)&lt;br&gt;4. Content &amp;rarr; PUBLISH thread:{id} (Redis Pub/Sub)&lt;br&gt;5. Notification Service &amp;rarr; XREADGROUP &amp;rarr; saves to DB &amp;rarr; PUBLISH user:{id}&lt;br&gt;6. Dashboard Service &amp;rarr; XREADGROUP &amp;rarr; saves audit_log to DB&lt;br&gt;7. Realtime Service &amp;rarr; SUBSCRIBE &amp;rarr; pushes to WebSocket clients&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="620" x="230" y="1050" as="geometry" />
        </mxCell>
